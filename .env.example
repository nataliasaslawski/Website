# Required for the contact form to actually send emails.
# Get this from https://resend.com after creating an account (Dashboard -> API Keys).
# Without it, the contact form falls back to a mailto: link instead of failing silently.
RESEND_API_KEY=

# Optional. The "from" address emails are sent from. Must be on a domain you have
# verified in Resend (Dashboard -> Domains). If left empty, emails send from
# Resend's shared onboarding@resend.dev address, which works but looks less
# professional and may only reliably reach your own account's registered address
# until a custom domain is verified.
CONTACT_FROM_EMAIL=

# Optional. Where contact-form submissions are delivered. Defaults to
# natalia.saslawski@gmail.com if left empty (set in code).
CONTACT_TO_EMAIL=
