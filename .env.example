# Required for the contact form to actually send emails.
# This is the Gmail address that sends the mail (e.g. natalia.saslawski@gmail.com).
GMAIL_USER=

# Required. A Google "App Password" for the account above — NOT your normal
# Gmail password. Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step-Verification to be enabled on the Google account first).
# Without this, the contact form falls back to a mailto: link instead of
# failing silently.
GMAIL_APP_PASSWORD=

# Optional. Where contact-form submissions are delivered. Defaults to
# natalia.saslawski@gmail.com if left empty (set in code).
CONTACT_TO_EMAIL=
